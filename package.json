{
  "name": "image-processor",
  "private": true,
  "description": "Convenience scripts; the stack itself runs entirely in Docker.",
  "scripts": {
    "up": "docker compose up --build",
    "down": "docker compose down",
    "test:api": "docker compose --profile test run --rm api-test",
    "test:web": "corepack pnpm --dir apps/web test",
    "smoke": "bash scripts/smoke.sh",
    "up:ts": "docker compose -f docker-compose.ts.yml up --build",
    "down:ts": "docker compose -f docker-compose.ts.yml down",
    "test:api-ts": "docker compose -f docker-compose.ts.yml --profile test run --rm api-test",
    "smoke:ts": "bash scripts/smoke.sh --ts"
  }
}
