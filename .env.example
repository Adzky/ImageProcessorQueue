# Optional overrides for docker compose. Every value below is already the default;
# copy to .env only if you want to change something.

APP_ENV=production
APP_DEBUG=false
# APP_KEY=base64:...   # compose ships a demo key; set your own outside the demo
LOG_LEVEL=info

DB_DATABASE=images
DB_USERNAME=images
DB_PASSWORD=secret

IMAGE_MAX_UPLOAD_KB=20480
IMAGE_MAX_DIMENSION=1280
IMAGE_QUALITY=80
IMAGE_MAX_PIXELS=50000000
IMAGE_STALE_AFTER_SECONDS=600
IMAGE_LOST_AFTER_SECONDS=3600
IMAGE_RETENTION_HOURS=24
# Demo only: artificial delay inside the worker so you can kill it mid-job.
IMAGE_PROCESSING_DELAY_MS=0
